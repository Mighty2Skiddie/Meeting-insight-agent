# ─────────────────────────────────────────────
#  Meeting Insight Agent — Environment Config
# ─────────────────────────────────────────────

# App
ENVIRONMENT=development         # development | staging | production
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_VERSION=1.0.0

# ── AI Providers ──────────────────────────────
# Primary (Paid) — https://platform.openai.com
OPENAI_API_KEY=sk-...

# Fallback Tier 2 (Free) — https://console.groq.com
GROQ_API_KEY=gsk_...

# Fallback Tier 2 (Free) — https://aistudio.google.com
GEMINI_API_KEY=AI...

# ── Budget Guard ──────────────────────────────
BUDGET_LIMIT_USD=2.00           # Total OpenAI spending cap
BUDGET_RESERVE_USD=0.20         # Switch to free tier when this much remains

# ── Storage ───────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/meetings.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=200

# ── Resilience ────────────────────────────────
CIRCUIT_BREAKER_FAIL_MAX=3
CIRCUIT_BREAKER_RESET_TIMEOUT=120
RETRY_MAX_ATTEMPTS=3
REQUEST_TIMEOUT_SECONDS=60

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_UPLOADS=10/minute
RATE_LIMIT_READS=30/minute

# ── Observability ─────────────────────────────
# Leave empty to disable tracing export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=meeting-insight-agent
